# The rules of Conway's Life and the shape of its board, for life.grem.
#
# This file only declares things. Loaded by itself it prints nothing.

WIDTH = 16
HEIGHT = 8

# The place of square (x, y) in a list that holds the board row after row.
# The board wraps around: column -1 is the last column and column WIDTH is
# the first, and the same goes for rows. `%` takes the sign of the divisor,
# so it wraps negative coordinates too.
def cell_index(x: Int, y: Int) -> Int
  x % WIDTH + (y % HEIGHT) * WIDTH
end

# Whether a square holds a live cell in the next generation, given whether
# it holds one now and how many of its eight neighbours do.
def alive_next?(alive: Bool, neighbours: Int) -> Bool
  if alive
    neighbours == 2 || neighbours == 3
  else
    neighbours == 3
  end
end
