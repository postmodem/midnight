# expect: a tick with neither change has no transfer. `add` and `remove` move
# a row to another table, so each touches every column with a GPU copy.
# `freeze` adds a tag: the row of Heat, which only the GPU copy has, comes
# back, a `rows` download, and in the new table the row of every component
# waits to be sent. `thaw` removes the tag right after: Heat's row comes back
# again, since bringing back rows leaves the GPU copy the only current one,
# and the rows of Heat and Rate it leaves are sent with the next `cool`,
# named after `thaw`, the last to leave any.

component Heat
  value: Float32
end

component Rate
  loss: Float32
end

tag Frozen

gpu system cool
  each Heat, Rate do |heat, rate|
    heat.value -= rate.loss * Time.dt
  end
end

system freeze
  each Entity, with: Heat, without: Frozen do |e|
    e.add(Frozen)
  end
end

system thaw
  each Entity, with: Frozen do |e|
    e.remove(Frozen)
  end
end

spawn Heat(100.0), Rate(0.5)
3.times do
  World.tick
end
