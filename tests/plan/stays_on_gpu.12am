# expect: nothing. A GPU system moves the entities and no ordinary code uses
# Position or Velocity during a tick, so both stay in GPU memory. The spawns
# before the first tick are set-up and not part of a tick.

component Position
  x: Float32
  y: Float32
end

component Velocity
  dx: Float32
  dy: Float32
end

gpu system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx * Time.dt
    pos.y += vel.dy * Time.dt
  end
end

1000.times do |i|
  spawn Position(i, 0.0), Velocity(1.0, 0.5)
end

Time.dt = 0.5
100.times do
  World.tick
end
