# clamp limits a value to a range, for Int and for Float: below the range,
# inside it and above it.
puts 5.clamp(1, 3)
puts 0.clamp(1, 3)
puts 2.clamp(1, 3)
puts -9.clamp(-5, 5)
n = 42
puts n.clamp(0, 10)
lo = 1
hi = 3
puts 3.clamp(lo, hi)
puts 1.clamp(lo, hi)
puts n.clamp(lo, hi) + 1

puts 2.5.clamp(0.0, 1.0)
puts -0.5.clamp(0.0, 1.0)
puts 0.25.clamp(0.0, 1.0)
x = 7.5
puts x.clamp(0, 5)
puts x.clamp(8, 9)
puts x.clamp(0.0, 10.0)
