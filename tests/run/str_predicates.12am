# empty?, include?, start_with? and end_with?.
puts "".empty?
puts "a".empty?
puts " ".empty?
s = "midnight"
puts s.include?("dni")
puts s.include?("xyz")
puts s.include?("M")
puts s.include?(s)
puts s.start_with?("mid")
puts s.start_with?("idn")
puts s.start_with?(s)
puts s.start_with?("midnights")
puts s.end_with?("ght")
puts s.end_with?("mid")
puts s.end_with?(s)
puts s.end_with?("a midnight")
t = "ght"
puts s.end_with?(t) && !s.start_with?(t)
blank = "x" * 0
puts blank.empty?
puts !s.empty?
