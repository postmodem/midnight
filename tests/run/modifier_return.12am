# Modifier `if` and `unless` on `return`, with and without a value.

resource Log
  count: Int = 0
end

def clamp(v: Float, lo: Float, hi: Float) -> Float
  return lo if v < lo
  return hi if v > hi
  v
end

def first_even(xs: [Int]) -> Int
  xs.each do |x|
    return x if x % 2 == 0
  end
  0
end

def note(n: Int)
  return if n < 0
  return unless n % 2 == 0
  Log.count += 1
end

puts clamp(-1.5, 0, 1)
puts clamp(0.25, 0, 1)
puts clamp(7, 0, 1)
puts first_even([3, 5, 8, 10])
puts first_even([1, 3])

note(-2)
note(3)
note(4)
note(6)
puts Log.count
