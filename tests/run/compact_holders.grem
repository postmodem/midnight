# Compact fields in a component, a resource and an event: defaults, reads,
# writes through each kind of place, and 64-bit arithmetic on values read.
component Health
  hp: UInt8 = 100
  armor: Int8 = -5
end

component Position
  x: Float32
  y: Float32
end

component Velocity
  dx: Float32
  dy: Float32
end

resource Stats
  kills: UInt16 = 0
  ratio: Float32 = 0.5
  offset: Int32 = -1
end

event Hit
  damage: UInt8
  knock: Int16 = -300
  force: Float32 = 2.5
end

system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx * Time.dt
    pos.y += vel.dy * Time.dt
  end
end

system damage
  on Hit do |hit|
    each Health do |health|
      health.hp -= hit.damage
      health.armor += 1
    end
    Stats.kills += 1
    puts hit.damage + hit.knock
    puts hit.force * 2
  end
end

e = spawn Health, Position(1, 2), Velocity(0.5, -0.25)
puts e[Health].hp
puts e[Health].hp * 3
puts e[Health].armor
local_hit = Hit(40)
local_hit.damage += 200
puts local_hit.damage
emit Hit(40)
Time.dt = 0.5
World.tick
puts e[Position].x
puts e[Position].y
puts e[Health]
puts Stats.kills
Stats.kills += 65534
puts Stats.kills
Stats.ratio *= 0.5
puts Stats.ratio
Stats.offset -= 1
puts Stats.offset
e[Health].hp = 255
puts e[Health].hp + 1
