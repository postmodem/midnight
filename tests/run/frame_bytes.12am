# Every value of a byte, in each of red, green and blue, is exactly that
# byte in a captured frame, on every device: tick k paints the background
# k, 255 - k and 7k modulo 256, and the capture after it holds that colour.

Window.open("Bytes", 16, 8)

system paint
  k = Time.tick % 256
  Window.background = Color(k, 255 - k, (k * 7) % 256)
end

World.run
puts "painted #{Time.tick} ticks"
