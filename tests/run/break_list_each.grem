# `break` in list `each` and `each_with_index`.

names = ["ann", "bob", "cy", "dee"]
names.each do |name|
  break if name == "cy"
  puts name
end

found = -1
names.each_with_index do |n, i|
  if n == "bob"
    found = i
    break
  end
end
puts found

nums = [5, 6, 7, 8]
sum = 0
nums.each do |v|
  sum += v
  break if sum > 10
end
puts sum
