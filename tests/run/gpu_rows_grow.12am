# A table outgrows the GPU buffers of its columns while the block that
# writes Position has left the GPU copy the only current one: the table is
# made exactly full, then grown by spawns between ticks. NAME.stats has what
# moves in each tick.
ENTITIES = 262_144

component Position
  x: Int32
  y: Int32
end

component Velocity
  dx: Int32
  dy: Int32
end

gpu system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx
    pos.y += vel.dy
  end
end

ENTITIES.times do |i|
  spawn Position(i % 1000, i / 1000), Velocity(i % 7 - 3, i % 5 - 2)
end

5.times do |t|
  World.tick
  (t + 1).times do |i|
    spawn Position(i, t), Velocity(t, i)
  end
end

sum = 0
each Position, Velocity do |pos, vel|
  sum = (sum * 31 + pos.x * 1000 + pos.y + vel.dx * 7 + vel.dy) % 1000003
end
puts "#{World.count(Position)} entities, checksum #{sum}"
