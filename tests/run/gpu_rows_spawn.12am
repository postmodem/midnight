# Spawns into a table whose columns a GPU block keeps in GPU memory: one a
# tick from an ordinary system's `each`, queued until the loop ends, and one
# from the top level between ticks, applied at once. The table holds 200,000
# rows of 8 bytes, enough for a row to travel alone. NAME.stats has what
# moves in each tick.
ENTITIES = 200_000

component Position
  x: Int32
  y: Int32
end

component Velocity
  dx: Int32
  dy: Int32
end

component Nest
  at: Int32
end

gpu system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx
    pos.y += vel.dy
  end
end

system hatch
  each Nest do |nest|
    spawn Position(nest.at, -nest.at), Velocity(1, -1)
  end
end

spawn Nest(7)
ENTITIES.times do |i|
  spawn Position(i % 1000, i / 1000), Velocity(i % 7 - 3, i % 5 - 2)
end

6.times do |t|
  World.tick
  spawn Position(t, t), Velocity(-1, 1)
end

sum = 0
each Position do |pos|
  sum = (sum * 31 + pos.x * 1000 + pos.y) % 1000003
end
puts "#{World.count(Position)} entities, checksum #{sum}"
