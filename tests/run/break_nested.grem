# `break` leaves only the nearest enclosing loop, across mixed loop forms.

3.times do |i|
  j = 0
  while true
    j += 1
    break if j > i
  end
  puts "#{i}: #{j}"
end

rows = [[1, 2, 3], [4, 5, 6]]
rows.each do |row|
  line = ""
  row.each do |cell|
    break if cell % 3 == 0
    line += cell.to_s
  end
  puts line
end

outer = 0
loop do
  outer += 1
  1.upto(10) do |k|
    break if k == 2
  end
  break if outer == 2
end
puts outer
