# Counting-loop receivers: a negative literal (the `-` belongs to the
# literal), a list length, a parenthesised expression, and struct fields.

struct Span
  from: Int
  to: Int
end

-1.upto(1) do |i|
  puts i
end

xs = [10, 20, 30]
xs.length.times do |j|
  puts xs[j]
end

(1 + 1).times do |k|
  puts "k#{k}"
end

span = Span(4, 6)
span.from.upto(span.to) do |s|
  puts s
end

-2.downto(-3) do |d|
  puts d
end
