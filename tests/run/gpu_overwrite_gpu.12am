# GPU blocks that assign a component an ordinary system wrote. `push`
# assigns every field of Force before reading it: it needs nothing from the
# CPU. Each of the others reads it, or might: a field read before the last
# field is assigned (Lean), a field left out (Heading), a read before the
# assignment (Spin), a nested `each` over the same component (Nest).
# NAME.stats has what moves in each tick.
component Position
  x: Int32
  y: Int32
end

component Force
  fx: Int32
  fy: Int32
end

component Lean
  a: Int32
  b: Int32
end

component Heading
  a: Int32
  b: Int32
end

component Spin
  a: Int32
  b: Int32
end

component Nest
  v: Int32
  w: Int32
end

gpu system push
  each Position, Force, Lean do |pos, force, lean|
    force.fx = pos.x * 2
    force.fy = pos.y + 1
    lean.a = force.fx
    lean.b = lean.a + force.fy
  end
  each Heading do |heading|
    heading.a = 7
  end
  each Spin do |spin|
    spin.a = spin.b
    spin.b = 0
  end
  each Nest do |nest|
    nest.v = 1
    nest.w = 2
    s = 0
    each Nest do |other|
      s += other.v
    end
    nest.v += s
  end
end

system nudge
  each Force, Lean, Heading, Spin, Nest do |force, lean, heading, spin, nest|
    force.fx += 1
    lean.b -= 1
    heading.b += force.fy
    spin.b += 3
    nest.w += nest.v
  end
end

4.times do |i|
  spawn Position(i, -i), Force(0, 0), Lean(0, 0), Heading(i, 1), Spin(i, 2), Nest(i, 5)
end

4.times do
  World.tick
end

each Force, Lean, Heading, Spin, Nest do |force, lean, heading, spin, nest|
  puts "#{force.fx} #{force.fy} #{lean.a} #{lean.b} #{heading.a} #{heading.b} #{spin.a} #{spin.b} #{nest.v} #{nest.w}"
end
