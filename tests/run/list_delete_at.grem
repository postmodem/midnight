# delete_at removes and returns the element at an index: first, middle
# and last.
xs = [10, 20, 30, 40, 50]
puts xs.delete_at(0)
puts xs
puts xs.delete_at(1)
puts xs
puts xs.delete_at(2)
puts xs
i = 1
gone = xs.delete_at(i)
puts gone
xs.delete_at(0)
puts xs
puts xs.length
names = ["a", "b", "c"]
names.delete_at(1)
puts names
puts names.delete_at(0) + names.delete_at(0)
puts names.empty?
