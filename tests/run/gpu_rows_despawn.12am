# Despawns from a table whose columns a GPU block keeps in GPU memory, the
# block writing Position and only reading Velocity. Between ticks the top
# level despawns, in turn: the last row; a row in the tail (spawned since
# the block last ran); a row whose Velocity was replaced; a row whose
# Position was changed in part; then a row from the middle in every tick,
# while `reap` queues one more from an `each`. The table holds 200,000 rows
# of 8 bytes, enough for a row to travel alone. NAME.stats has what moves in
# each tick.
ENTITIES = 200_000

component Position
  x: Int32
  y: Int32
end

component Velocity
  dx: Int32
  dy: Int32
end

component Reaper
  target: Entity
end

gpu system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx
    pos.y += vel.dy
  end
end

system reap
  each Reaper do |reaper|
    reaper.target.despawn
  end
end

reaper = spawn Reaper(Entity.none)
victims: [Entity] = []
last = Entity.none
ENTITIES.times do |i|
  last = spawn Position(i % 1000, i / 1000), Velocity(i % 7 - 3, i % 5 - 2)
  victims.push(last) if i % 5000 == 17
end

10.times do |t|
  World.tick
  if t == 0
    last.despawn
  elsif t == 1
    a = spawn Position(1, 1), Velocity(1, 1)
    b = spawn Position(2, 2), Velocity(2, 2)
    a.despawn
    b[Velocity].dx = 5
  elsif t == 2
    victims[0][Velocity] = Velocity(5, 5)
    victims[0].despawn
  elsif t == 3
    victims[1][Position].x = 3
    victims[1].despawn
  else
    victims[t].despawn
    reaper[Reaper] = Reaper(victims[t + 10])
  end
end

sum = 0
each Position, Velocity do |pos, vel|
  sum = (sum * 31 + pos.x * 1000 + pos.y + vel.dx * 7 + vel.dy) % 1000003
end
puts "#{World.count(Position)} entities, checksum #{sum}"
