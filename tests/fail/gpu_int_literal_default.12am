# expect: 4294967296 does not fit in 32 bits, for a field default that a constructor in a GPU system uses
# at: line 9, the default `4294967296`; note at line 15, the constructor `Range()`

component Body
  n: Int32
end

struct Range
  max: Int = 4294967296
  min: Int = 0
end

gpu system clamp
  each Body do |body|
    range = Range()
    body.n = max(body.n, range.min)
  end
end
