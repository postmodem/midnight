# expect: constant `START` can't be read in a GPU system, because it is a `Grid`, whose field `cell.mask`, inside a struct, is a `UInt32`; reading its other field `width` is no different
# at: line 22, the name `START`

component Body
  n: Int32
end

struct Cell
  mask: UInt32
  age: Int32
end

struct Grid
  width: Int
  cell: Cell
end

START = Grid(8, Cell(1, 2))

gpu system grow
  each Body do |body|
    body.n += START.width
  end
end
