# expect: `break` can't leave the `each` of a GPU system; the `break` inside the `while` is fine
# at: line 15, the keyword `break`

component Body
  x: Float32
end

gpu system settle
  each Body do |body|
    while body.x > 10
      body.x /= 2
      break if body.x < 11
    end
    if body.x < 0
      break
    end
  end
end
