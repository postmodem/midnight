# expect: `Cell` can't be built in a GPU system, because its field `mask` is a `UInt32`; hint to declare it `Int32`
# at: line 15, the constructor `Cell(body.n, 1)`

component Body
  n: Int32
end

struct Cell
  mask: UInt32
  age: Int32
end

gpu system mark
  each Body do |body|
    cell = Cell(body.n, 1)
    body.n = cell.age
  end
end
