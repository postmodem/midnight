# expect: field `mask` of `Cell` can't be read in a GPU system, on the result of a call; the call itself, which takes and returns a `Cell`, is fine, and so is `.age` on line 24
# at: line 25, the expression `newer(Config.cell).mask`

component Body
  n: Int32
end

struct Cell
  mask: UInt32 = 0
  age: Int32 = 0
end

resource Config
  cell: Cell = Cell()
  spare: Cell = Cell()
end

def newer(cell: Cell) -> Cell
  cell.age < Config.spare.age ? cell : Config.spare
end

gpu system mark
  each Body do |body|
    body.n = newer(Config.cell).age
    body.n += newer(Config.cell).mask
  end
end
