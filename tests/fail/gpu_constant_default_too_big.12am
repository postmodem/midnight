# expect: constant `BIG` is 5000000000, which does not fit in 32 bits, in a field default that a constructor in a GPU system uses
# at: line 11, the name `BIG`; note at line 17, the constructor `Range()`

BIG = 5000000000

component Body
  n: Int32
end

struct Range
  max: Int = BIG
  min: Int = 0
end

gpu system clamp
  each Body do |body|
    range = Range()
    body.n = max(body.n, range.min)
  end
end
