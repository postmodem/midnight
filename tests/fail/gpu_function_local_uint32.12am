# expect: `Cell` values are not allowed in a function called from a GPU system, because the field `mask` is a `UInt32`; the ordinary call on line 24 is fine
# at: line 14, the constructor `Cell(n, 1)`; note at line 20, the call `masked(body.n)`

component Body
  n: Int32
end

struct Cell
  mask: UInt32
  age: Int32
end

def masked(n: Int) -> Int
  cell = Cell(n, 1)
  cell.mask + cell.age
end

gpu system mark
  each Body do |body|
    body.n = masked(body.n)
  end
end

puts masked(7)
