component Rabbit
  num: Int
  pos: Int
  age: Int
  crowd: Int = 0
end

component Fox
  num: Int
  pos: Int
  hunger: Int = 0
  meals: Int = 0
  prey: Int = 0
  ate: Bool = false
  cub: Bool = false
end

resource Warren
  next_rabbit: Int = 1
  next_fox: Int = 1
  eaten: Int = 0
  born: Int = 0
  cubs: Int = 0
  starved: Int = 0
end

MEADOW = 12

def add_rabbit(pos: Int, age: Int)
  spawn Rabbit(Warren.next_rabbit, pos, age)
  Warren.next_rabbit += 1
end

def add_fox(pos: Int)
  spawn Fox(num: Warren.next_fox, pos: pos)
  Warren.next_fox += 1
end

# Every fox picks the lowest-numbered rabbit at its place; a rabbit picked
# by several foxes goes to the lowest-numbered of them.
system hunt
  Warren.eaten = 0
  Warren.born = 0
  Warren.cubs = 0
  Warren.starved = 0
  each Fox do |f|
    f.ate = false
    f.prey = 0
    each Rabbit do |r|
      f.prey = r.num if r.pos == f.pos && (f.prey == 0 || r.num < f.prey)
    end
  end
  each Entity, Rabbit do |e, r|
    winner = 0
    each Fox do |f|
      winner = f.num if f.prey == r.num && (winner == 0 || f.num < winner)
    end
    next if winner == 0
    each Fox do |f|
      f.ate = true if f.num == winner
    end
    e.despawn
    Warren.eaten += 1
  end
end

system foxes
  each Entity, Fox do |e, f|
    f.cub = false
    if f.ate
      f.hunger = 0
      f.meals += 1
      if f.meals == 2
        f.meals = 0
        f.cub = true
      end
    else
      f.hunger += 1
      if f.hunger == 3
        e.despawn
        Warren.starved += 1
      else
        f.pos = (f.pos + 2) % MEADOW
      end
    end
  end
  last = Warren.next_fox
  1.upto(last - 1) do |n|
    each Fox do |f|
      if f.num == n && f.cub
        add_fox(f.pos)
        Warren.cubs += 1
      end
    end
  end
end

system rabbits
  each Rabbit do |r|
    r.crowd = 0
    each Rabbit do |other|
      r.crowd += 1 if other.pos == r.pos
    end
  end
  last = Warren.next_rabbit
  1.upto(last - 1) do |n|
    each Rabbit do |r|
      if r.num == n && r.age >= 2 && r.crowd <= 3
        add_rabbit(r.pos, 0)
        Warren.born += 1
      end
    end
  end
  each Rabbit do |r|
    r.age += 1 if r.num < last
  end
end

system report
  print "tick #{Time.tick + 1}: #{World.count(Rabbit)} rabbits, #{World.count(Fox)} foxes, "
  puts "#{Warren.eaten} eaten, #{Warren.born} born, #{Warren.cubs} cubs, #{Warren.starved} starved"
end

Warren.next_rabbit = 11
Warren.next_fox = 4
spawn Rabbit(8, 5, 2)
spawn Rabbit(2, 0, 1)
spawn Rabbit(9, 10, 3)
spawn Rabbit(1, 5, 3)
spawn Rabbit(10, 7, 2)
spawn Rabbit(4, 10, 0)
spawn Rabbit(6, 5, 4)
spawn Rabbit(3, 6, 0)
spawn Rabbit(7, 9, 1)
spawn Rabbit(5, 11, 2)
spawn Fox(num: 2, pos: 1, meals: 1)
spawn Fox(num: 1, pos: 5)
spawn Fox(num: 3, pos: 8)

15.times do
  World.tick
end
