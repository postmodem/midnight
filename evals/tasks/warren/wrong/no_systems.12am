# Prints the expected output with plain loops over lists, and no systems.

struct Rabbit
  id: Int
  place: Int
  age: Int
end

struct Fox
  id: Int
  place: Int
  hunger: Int
  meals: Int
end

# Kept sorted by number, lowest first.
rabbits: [Rabbit] = [
  Rabbit(1, 5, 3),
  Rabbit(2, 0, 1),
  Rabbit(3, 6, 0),
  Rabbit(4, 10, 0),
  Rabbit(5, 11, 2),
  Rabbit(6, 5, 4),
  Rabbit(7, 9, 1),
  Rabbit(8, 5, 2),
  Rabbit(9, 10, 3),
  Rabbit(10, 7, 2)
]

foxes: [Fox] = [
  Fox(1, 5, 0, 0),
  Fox(2, 1, 0, 1),
  Fox(3, 8, 0, 0)
]

next_rabbit = 11
next_fox = 4

15.times do |t|
  eaten = 0
  born = 0
  cubs = 0
  starved = 0

  # Step 1: hunt. Foxes are in number order, so the lowest-numbered fox that
  # picks a rabbit is the one that eats it.
  nr = rabbits.length
  taken: [Bool] = [false] * nr
  nf = foxes.length
  ate: [Bool] = [false] * nf
  nf.times do |i|
    target = -1
    nr.times do |j|
      if target < 0 && rabbits[j].place == foxes[i].place
        target = j
      end
    end
    if target >= 0 && !taken[target]
      taken[target] = true
      ate[i] = true
      eaten += 1
    end
  end

  eaten_rabbits: [Rabbit] = []
  nr.times do |j|
    eaten_rabbits.push(rabbits[j]) unless taken[j]
  end
  rabbits = eaten_rabbits

  # Step 2: foxes.
  dead_f: [Bool] = [false] * nf
  newcubs: [Fox] = []
  nf.times do |i|
    if ate[i]
      foxes[i].hunger = 0
      foxes[i].meals += 1
      if foxes[i].meals == 2
        foxes[i].meals = 0
        newcubs.push(Fox(next_fox, foxes[i].place, 0, 0))
        next_fox += 1
        cubs += 1
      end
    else
      foxes[i].hunger += 1
      if foxes[i].hunger == 3
        dead_f[i] = true
        starved += 1
      else
        foxes[i].place = (foxes[i].place + 2) % 12
      end
    end
  end

  alive_foxes: [Fox] = []
  nf.times do |i|
    alive_foxes.push(foxes[i]) unless dead_f[i]
  end
  newcubs.each do |cub|
    alive_foxes.push(cub)
  end
  foxes = alive_foxes

  # Step 3: rabbits. Decide every birth from the state at the start of the
  # step, then age the rabbits that were there, then add the babies.
  nr2 = rabbits.length
  baby_places: [Int] = []
  nr2.times do |j|
    count = 0
    nr2.times do |k|
      if rabbits[k].place == rabbits[j].place
        count += 1
      end
    end
    if rabbits[j].age >= 2 && count <= 3
      baby_places.push(rabbits[j].place)
    end
  end
  nr2.times do |j|
    rabbits[j].age += 1
  end
  baby_places.each do |where|
    rabbits.push(Rabbit(next_rabbit, where, 0))
    next_rabbit += 1
    born += 1
  end

  # Step 4: report.
  puts "tick #{t + 1}: #{rabbits.length} rabbits, #{foxes.length} foxes, #{eaten} eaten, #{born} born, #{cubs} cubs, #{starved} starved"
end
