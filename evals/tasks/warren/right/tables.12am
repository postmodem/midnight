# Places, rabbits and foxes in separate components, a tag for a fox that
# has eaten, crowds counted in a list, newborns added outside any query.
component Place
  at: Int
end

component Bunny
  num: Int
  age: Int
end

component Hunter
  num: Int
  hunger: Int
  meals: Int
  pick: Int
end

tag Fed

resource Counts
  rabbits_made: Int = 0
  foxes_made: Int = 0
  eaten: Int = 0
  born: Int = 0
  cubs: Int = 0
  starved: Int = 0
end

struct Parent
  num: Int
  at: Int
end

def lowest_first(list: [Parent]) -> [Parent]
  rest = list
  out: [Parent] = []
  while !rest.empty?
    k = 0
    rest.each_with_index do |p, i|
      k = i if p.num < rest[k].num
    end
    out.push(rest.delete_at(k))
  end
  out
end

def new_bunny(at: Int, age: Int)
  Counts.rabbits_made += 1
  spawn Bunny(Counts.rabbits_made, age), Place(at)
end

def new_hunter(at: Int)
  Counts.foxes_made += 1
  spawn Place(at), Hunter(Counts.foxes_made, 0, 0, 0)
end

system hunt
  Counts.eaten = 0
  Counts.born = 0
  Counts.cubs = 0
  Counts.starved = 0
  each Hunter, Place do |h, p|
    h.pick = 0
    each Bunny, Place do |b, q|
      if q.at == p.at
        h.pick = b.num if h.pick == 0 || b.num < h.pick
      end
    end
  end
  each Entity, Bunny do |rabbit, b|
    winner = Entity.none
    lowest = 0
    each Entity, Hunter do |fox, h|
      if h.pick == b.num && (lowest == 0 || h.num < lowest)
        lowest = h.num
        winner = fox
      end
    end
    if winner.alive?
      winner.add(Fed)
      rabbit.despawn
      Counts.eaten += 1
    end
  end
end

system foxes
  parents: [Parent] = []
  each Entity, Hunter, Place do |e, h, p|
    if e.has?(Fed)
      e.remove(Fed)
      h.hunger = 0
      h.meals += 1
      if h.meals == 2
        h.meals = 0
        parents.push(Parent(h.num, p.at))
      end
    elsif h.hunger == 2
      e.despawn
      Counts.starved += 1
    else
      h.hunger += 1
      p.at += 2
      p.at -= 12 if p.at >= 12
    end
  end
  lowest_first(parents).each do |parent|
    new_hunter(parent.at)
    Counts.cubs += 1
  end
end

system rabbits
  crowd = [0] * 12
  each Bunny, Place do |b, p|
    crowd[p.at] += 1
  end
  parents: [Parent] = []
  each Bunny, Place do |b, p|
    parents.push(Parent(b.num, p.at)) if b.age > 1 && crowd[p.at] < 4
    b.age += 1
  end
  lowest_first(parents).each do |parent|
    new_bunny(parent.at, 0)
    Counts.born += 1
  end
end

system report
  rabbits = World.count(Bunny)
  foxes = World.count(Hunter)
  puts "tick #{Time.tick + 1}: #{rabbits} rabbits, #{foxes} foxes, #{Counts.eaten} eaten, #{Counts.born} born, #{Counts.cubs} cubs, #{Counts.starved} starved"
end

Counts.foxes_made = 3
spawn Hunter(3, 0, 0, 0), Place(8)
spawn Place(5), Hunter(1, 0, 0, 0)
spawn Hunter(2, 0, 1, 0), Place(1)

Counts.rabbits_made = 10
spawn Bunny(10, 2), Place(7)
spawn Place(10), Bunny(9, 3)
spawn Bunny(1, 3), Place(5)
spawn Bunny(7, 1), Place(9)
spawn Bunny(3, 0), Place(6)
spawn Bunny(6, 4), Place(5)
spawn Bunny(5, 2), Place(11)
spawn Bunny(4, 0), Place(10)
spawn Bunny(2, 1), Place(0)
spawn Place(5), Bunny(8, 2)

until Time.tick == 15
  World.tick
end
