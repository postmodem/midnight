# The picture is drawn by three systems after `report`, from constants.

LEFT = 8.0
WIDE = 224.0
HORIZON = 112.0

system report
  puts "tick #{Time.tick + 1}"
end

system back
  Draw.rect(LEFT, HORIZON - 100.0, WIDE, 100.0, Color(40, 70, 130))
  Draw.circle(182, 40, 18, Color(250, 210, 60))
end

system front
  Draw.triangle(100, HORIZON, 172, 34, 226, HORIZON, Color(90, 80, 70))
  Draw.rect(LEFT, HORIZON, WIDE, 56.0, Color(50, 110, 40))
end

system path
  Draw.line(64, 166, 118, 114, 3, Color(200, 180, 140, 160))
end

Window.background = Color(20, 24, 36)
Window.open("Poster", 240, 180)
World.run
puts "closed after #{Time.tick} ticks"
