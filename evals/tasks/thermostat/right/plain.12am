# Plain top-level code: no systems and no entities.
temp = 10
powers = [3, 2, 4]
limits = [0, 0, 4]
used = [0, 0, 0]
energy = 0
15.times do |i|
  on_now = 0
  if temp < 21
    3.times do |h|
      if limits[h] == 0 || used[h] < limits[h]
        temp += powers[h]
        energy += powers[h]
        used[h] += 1
        on_now += 1
      end
    end
  end
  temp -= (temp - 5) / 5
  puts "tick #{i + 1}: #{temp} degrees, heaters on: #{on_now}, energy: #{energy}"
end
