# Heaters in two tables: those with a fuse and those without.
component Power
  amount: Int
end

component Fuse
  ticks_left: Int
end

resource Room
  temp: Int = 10
  heaters_on: Int = 0
  energy: Int = 0
end

def heating? -> Bool
  Room.temp < 21
end

system heat
  Room.heaters_on = 0
  return unless heating?
  total = 0
  each Power, without: Fuse do |p|
    total += p.amount
    Room.heaters_on += 1
  end
  each Power, Fuse do |p, fuse|
    if fuse.ticks_left > 0
      total += p.amount
      fuse.ticks_left -= 1
      Room.heaters_on += 1
    end
  end
  Room.temp = Room.temp + total
  Room.energy = Room.energy + total
end

system cool
  loss = (Room.temp - 5) / 5
  Room.temp = Room.temp - loss
end

system report
  print "tick ", Time.tick + 1, ": ", Room.temp, " degrees, heaters on: "
  puts "#{Room.heaters_on}, energy: #{Room.energy}"
end

spawn Power(4), Fuse(4)
spawn Power(2)
spawn Power(3)

while Time.tick < 15
  World.tick
end
