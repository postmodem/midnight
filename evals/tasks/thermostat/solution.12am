component Heater
  power: Int
  limit: Int
  ticks_on: Int = 0
end

resource Room
  temp: Int = 10
  running: Int = 0
  energy: Int = 0
end

SET_POINT = 21
OUTSIDE = 5

def working?(h: Heater) -> Bool
  h.limit == 0 || h.ticks_on < h.limit
end

system heat
  Room.running = 0
  if Room.temp < SET_POINT
    added = 0
    each Heater do |h|
      if working?(h)
        added += h.power
        h.ticks_on += 1
        Room.running += 1
      end
    end
    Room.temp += added
    Room.energy += added
  end
end

system cool
  Room.temp -= (Room.temp - OUTSIDE) / 5
end

system report
  puts "tick #{Time.tick + 1}: #{Room.temp} degrees, heaters on: #{Room.running}, energy: #{Room.energy}"
end

spawn Heater(power: 3, limit: 0)
spawn Heater(power: 2, limit: 0)
spawn Heater(power: 4, limit: 4)

15.times do
  World.tick
end
