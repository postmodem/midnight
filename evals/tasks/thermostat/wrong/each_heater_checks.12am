# Each heater looks at the temperature as the heaters before it left it.
component Heater
  power: Int
  limit: Int
  ticks_on: Int = 0
end

resource Room
  temp: Int = 10
  running: Int = 0
  energy: Int = 0
end

system heat
  Room.running = 0
  each Heater do |h|
    if Room.temp < 21 && (h.limit == 0 || h.ticks_on < h.limit)
      Room.temp += h.power
      Room.energy += h.power
      h.ticks_on += 1
      Room.running += 1
    end
  end
end

system cool
  Room.temp -= (Room.temp - 5) / 5
end

system report
  puts "tick #{Time.tick + 1}: #{Room.temp} degrees, heaters on: #{Room.running}, energy: #{Room.energy}"
end

spawn Heater(power: 3, limit: 0)
spawn Heater(power: 2, limit: 0)
spawn Heater(power: 4, limit: 4)

15.times do
  World.tick
end
