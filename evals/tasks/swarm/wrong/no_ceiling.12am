# A particle above 64 does not bounce off the ceiling.
component Particle
  x: Float32
  y: Float32
  vx: Float32
  vy: Float32
  bounces: Int32 = 0
end

SIZE = 64.0
GRAVITY = 0.0625

gpu system move
  each Particle do |p|
    p.vy -= GRAVITY
    p.x += p.vx
    p.y += p.vy
    if p.x < 0.0
      p.x = -p.x
      p.vx = -p.vx
      p.bounces += 1
    elsif p.x > SIZE
      p.x = 2.0 * SIZE - p.x
      p.vx = -p.vx
      p.bounces += 1
    end
    if p.y < 0.0
      p.y = -p.y
      p.vy = -p.vy
      p.bounces += 1
    end
  end
end

# 0 for a coordinate below 16, 1 below 32, 2 below 48, 3 from 48 up.
def band(v: Float) -> Int
  min((v / 16.0).floor, 3)
end

def report
  counts = [0] * 16
  bounces = 0
  each Particle do |p|
    row = 3 - band(p.y)
    counts[row * 4 + band(p.x)] += 1
    bounces += p.bounces
  end
  puts "tick #{Time.tick}: #{bounces} bounces"
  4.times do |row|
    puts "row #{row + 1}: #{counts[row * 4]} #{counts[row * 4 + 1]} #{counts[row * 4 + 2]} #{counts[row * 4 + 3]}"
  end
end

10000.times do |n|
  spawn Particle(x: (n * 37 % 1024) / 16.0, y: (n * 91 % 1024) / 16.0,
                 vx: (n % 7 - 3) / 4.0, vy: (n % 5 - 2) / 4.0)
end

report
6.times do
  10.times do
    World.tick
  end
  report
end
