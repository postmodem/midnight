# Position, velocity and looks are components of their own; bubbles with
# an even number carry a tag, so they live in another table. `report`
# counts and draws.

component Pos
  x: Float
  y: Float
end

component Vel
  dx: Int
  dy: Int
end

component Look
  num: Int
  radius: Int
end

tag Even

resource Tally
  upcoming: Int = 1
  gone: Int = 0
end

def color_of(k: Int) -> Color
  Color(100 + 30 * (k % 4), 210, 255)
end

system launch
  if Time.tick % 3 == 0
    k = Tally.upcoming
    Tally.upcoming += 1
    m = k % 4
    if k % 2 == 0
      spawn Look(k, 1 + k % 3), Vel(8 + 3 * m, -1), Pos(8, 150 - 9 * m), Even
    else
      spawn Vel(8 + 3 * m, -1 - 1), Pos(8, 150 - 9 * m), Look(k, 1 + k % 3)
    end
  end
end

system move
  each Entity, Pos, Vel do |e, p, v|
    p = Pos(p.x + v.dx, p.y + v.dy)
    if p.x > 288.0
      e.despawn
      Tally.gone += 1
    end
  end
end

system report
  n = 0
  each Pos, Look do |p, look|
    n += 1
    Draw.circle(p.x, p.y, look.radius, color_of(look.num))
  end
  Draw.rect(0, 160, 288, 16, Color(194, 178, 128))
  puts "tick #{Time.tick + 1}: #{n} bubbles, #{Tally.gone} gone"
end

Window.open("Drift", 288, 176)
Window.background = Color(8, 30, 52)
World.run
puts "closed after #{Time.tick} ticks"
