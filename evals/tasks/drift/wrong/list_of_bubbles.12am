# The bubbles are kept in a list in a resource, not as entities, so `move`
# has no `each`. Prints and draws what is expected.

struct Bubble
  x: Float
  y: Float
  vx: Float
  vy: Float
  radius: Float
  color: Color
end

resource Water
  bubbles: [Bubble] = []
  made: Int = 0
  gone: Int = 0
end

system launch
  if (Time.tick + 1) % 3 == 1
    Water.made += 1
    k = Water.made
    Water.bubbles.push(Bubble(8, 150 - 9 * (k % 4), 8 + 3 * (k % 4), -1 - k % 2,
                              1 + k % 3, Color(100 + 30 * (k % 4), 210, 255)))
  end
end

system move
  kept: [Bubble] = []
  Water.bubbles.each do |b|
    moved = Bubble(b.x + b.vx, b.y + b.vy, b.vx, b.vy, b.radius, b.color)
    if moved.x > 288
      Water.gone += 1
    else
      kept.push(moved)
    end
  end
  Water.bubbles = kept
end

system report
  puts "tick #{Time.tick + 1}: #{Water.bubbles.length} bubbles, #{Water.gone} gone"
  Draw.rect(0, 160, 288, 16, Color(194, 178, 128))
  Water.bubbles.each do |b|
    Draw.circle(b.x, b.y, b.radius, b.color)
  end
end

Window.background = Color(8, 30, 52)
Window.open("Drift", 288, 176)
World.run
puts "closed after #{Time.tick} ticks"
