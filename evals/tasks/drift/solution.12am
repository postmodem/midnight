# Bubbles appear at the left every third tick, drift right and up, and
# are gone once they have passed the right edge. Every frame shows the
# sand at the bottom and each bubble where it is when the tick ends.

WIDTH = 288
HEIGHT = 176

component Bubble
  x: Float32
  y: Float32
  vx: Float32
  vy: Float32
  radius: Float32
  color: Color
end

resource Count
  made: Int = 0
  gone: Int = 0
end

system launch
  if (Time.tick + 1) % 3 == 1
    Count.made += 1
    k = Count.made
    spawn Bubble(8, 150 - 9 * (k % 4), 8 + 3 * (k % 4), -1 - k % 2, 1 + k % 3,
                 Color(100 + 30 * (k % 4), 210, 255))
  end
end

system move
  each Entity, Bubble do |e, b|
    b.x += b.vx
    b.y += b.vy
    if b.x > WIDTH
      e.despawn
      Count.gone += 1
    end
  end
end

system report
  n = 0
  each Bubble do |b|
    n += 1
  end
  puts "tick #{Time.tick + 1}: #{n} bubbles, #{Count.gone} gone"
end

system show
  Draw.rect(0, 160, WIDTH, 16, Color(194, 178, 128))
  each Bubble do |b|
    Draw.circle(b.x, b.y, b.radius, b.color)
  end
end

Window.background = Color(8, 30, 52)
Window.open("Drift", WIDTH, HEIGHT)
World.run
puts "closed after #{Time.tick} ticks"
