# The loop over the walkers in a function that walk calls, not in walk itself.
component Walker
  pos: Int32
  speed: Int32
  stamina: Int32
end

resource Tally
  steps: Int = 0
  resting: Int = 0
  q1: Int = 0
  q2: Int = 0
  q3: Int = 0
  q4: Int = 0
  total: Int = 0
end

ROAD = 400

def step_all
  each Walker do |w|
    if w.stamina > 0
      w.pos = (w.pos + w.speed) % ROAD
      w.stamina -= 1
      Tally.steps += w.speed
    else
      w.stamina = 6 - w.speed
      Tally.resting += 1
    end
    case w.pos / 100
    when 0 then Tally.q1 += 1
    when 1 then Tally.q2 += 1
    when 2 then Tally.q3 += 1
    else Tally.q4 += 1
    end
  end
end

system walk
  Tally.steps = 0
  Tally.resting = 0
  Tally.q1 = 0
  Tally.q2 = 0
  Tally.q3 = 0
  Tally.q4 = 0
  step_all
  Tally.total += Tally.steps
end

system report
  puts "tick #{Time.tick + 1}: #{Tally.steps} steps, #{Tally.resting} resting, quarters #{Tally.q1} #{Tally.q2} #{Tally.q3} #{Tally.q4}, #{Tally.total} in all"
end

200000.times do |n|
  spawn Walker(pos: 100 + n * 37 % 300, speed: 1 + n % 5, stamina: n % 6)
end

12.times do
  World.tick
end
