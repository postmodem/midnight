# Place and pace in components of their own, walkers that start in the
# last quarter tagged, spawned from the last number to the first; the tally
# is cleared after it is printed, and the quarter worked out in a helper.

component Place
  at: Int32
end

component Pace
  speed: Int32
  energy: Int32
end

tag Far

resource Count
  steps: Int = 0
  resting: Int = 0
  first: Int = 0
  second: Int = 0
  third: Int = 0
  fourth: Int = 0
  all_steps: Int = 0
end

def quarter(at: Int) -> Int
  if at < 100
    1
  elsif at < 200
    2
  elsif at < 300
    3
  else
    4
  end
end

system walk
  each Place, Pace do |place, pace|
    if pace.energy == 0
      pace.energy = 6 - pace.speed
      Count.resting += 1
    else
      place.at = place.at + pace.speed
      place.at -= 400 if place.at >= 400
      pace.energy -= 1
      Count.steps += pace.speed
      Count.all_steps += pace.speed
    end
    q = quarter(place.at)
    Count.first += 1 if q == 1
    Count.second += 1 if q == 2
    Count.third += 1 if q == 3
    Count.fourth += 1 if q == 4
  end
end

system report
  print "tick #{Time.tick + 1}: #{Count.steps} steps, #{Count.resting} resting, "
  puts "quarters #{Count.first} #{Count.second} #{Count.third} #{Count.fourth}, #{Count.all_steps} in all"
  Count.steps = 0
  Count.resting = 0
  Count.first = 0
  Count.second = 0
  Count.third = 0
  Count.fourth = 0
end

n = 199999
while n >= 0
  at = 100 + n * 37 % 300
  if at >= 300
    spawn Pace(1 + n % 5, n % 6), Place(at), Far
  else
    spawn Place(at), Pace(1 + n % 5, n % 6)
  end
  n -= 1
end

World.tick
11.times do
  World.tick
end
