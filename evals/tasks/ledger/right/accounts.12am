# Terms and account in components of their own, long loans tagged,
# spawned in number order from the highest; the growth factor in a helper,
# the lines printed from a list put in number order.

component Terms
  principal: Float32
  rate: Float32
  months: Int32
end

component Account
  num: Int32
  owed: Float32 = 0.0
  monthly: Float32 = 0.0
  to_go: Int32 = 0
  started: Bool = false
end

tag Long

def growth(r: Float, months: Int) -> Float
  f = 1.0
  k = 0
  while k < months
    f = f * (1.0 + r)
    k += 1
  end
  f
end

strict gpu system amortize
  each Terms, Account do |t, a|
    r = t.rate / 12.0
    unless a.started
      f = growth(r, t.months)
      a.monthly = t.principal * r * f / (f - 1.0)
      a.owed = t.principal
      a.to_go = t.months
      a.started = true
    end
    if a.to_go > 0
      interest = a.owed * r
      a.owed = a.owed + interest - a.monthly
      a.to_go = a.to_go - 1
    end
  end
end

def to_cents(x: Float) -> Int
  (x * 100.0).round
end

def report
  lines = ["", "", "", "", "", ""]
  each Account do |a|
    lines[a.num - 1] = "loan #{a.num}: pays #{to_cents(a.monthly)}, owes #{to_cents(a.owed)}"
  end
  puts "month #{Time.tick}"
  lines.each do |line|
    puts line
  end
end

spawn Account(num: 6), Terms(600.0, 0.18, 6)
spawn Account(num: 5), Terms(135000.0, 0.0425, 360), Long
spawn Terms(10000.0, 0.0725, 24), Account(num: 4)
spawn Account(num: 3), Terms(25000.0, 0.06, 60), Long
spawn Account(num: 2), Terms(4500.0, 0.085, 36)
spawn Account(num: 1), Terms(1800.0, 0.12, 12)

World.tick
report
while Time.tick < 48
  World.tick
  report if Time.tick % 12 == 0
end
