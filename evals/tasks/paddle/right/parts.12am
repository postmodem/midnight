# Position, velocity and the serve in components of their own, ball 1
# tagged, the paddle spawned first; the tick's lines gathered and printed
# in ball order, and the ticks run by a loop of the program's own.

component Pos
  x: Int
  y: Int
end

component Vel
  dx: Int
  dy: Int
end

component Serve
  num: Int
  x: Int
  y: Int
  dx: Int
  dy: Int
end

component Bat
  left: Int = 136
end

tag First

resource Score
  hits: Int = 0
  misses: Int = 0
end

def direction -> Int
  d = 0
  d -= 1 if Keyboard.down?(Key::ArrowLeft)
  d += 1 if Keyboard.down?(Key::ArrowRight)
  d
end

system steer
  d = direction
  each Bat do |bat|
    bat.left = max(0, min(272, bat.left + 6 * d))
  end
end

system move
  each Pos, Vel do |p, v|
    p.x = p.x + v.dx
    p.y = p.y + v.dy
    if p.x < 0 || p.x > 320
      p.x = p.x < 0 ? -p.x : 640 - p.x
      v.dx = -v.dx
    end
    if p.y < 0
      p.y = -p.y
      v.dy = -v.dy
    end
  end
end

system score
  bat = 0
  each Bat do |b|
    bat = b.left
  end
  lines = ["", ""]
  each Pos, Vel, Serve do |p, v, s|
    if p.y >= 220
      if p.x < bat || p.x > bat + 48
        p.x = s.x
        p.y = s.y
        v.dx = s.dx
        v.dy = s.dy
        Score.misses += 1
        lines[s.num - 1] = "tick #{Time.tick + 1}: ball #{s.num} missed"
      else
        p.y = 440 - p.y
        v.dy = -v.dy
        Score.hits += 1
        lines[s.num - 1] = "tick #{Time.tick + 1}: ball #{s.num} hit at #{p.x}"
      end
    end
  end
  lines.each do |line|
    puts line unless line.empty?
  end
end

spawn Bat
spawn Serve(1, 40, 30, 4, 5), Pos(40, 30), Vel(4, 5), First
spawn Vel(-3, 6), Pos(250, 106), Serve(2, 250, 106, -3, 6)

Window.open("Paddle", 320, 240)
while Window.open?
  World.tick
end
bat_at = 0
each Bat do |b|
  bat_at = b.left
end
puts "#{Score.hits} hits, #{Score.misses} misses, #{Time.tick} ticks, paddle at #{bat_at}"
