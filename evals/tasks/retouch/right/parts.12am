# The boat's position is an `Int` in a component with a tag beside it;
# the water and the boat are drawn by two systems after `report`.

component Hull
  left: Int
end

tag Sailing

SEA = Color(30, 80, 160)

system sail
  each Hull, with: Sailing do |hull|
    hull.left = hull.left + 2
  end
end

system report
  each Hull do |hull|
    puts "tick #{Time.tick + 1}: boat at #{hull.left}"
  end
end

system water
  Draw.rect(0.0, 96.0, 224.0, 48.0, SEA)
  Draw.circle(40.0, 30.0, 14.0, Color(255, 220, 90, 255))
end

system boat
  each Hull do |hull|
    x = hull.left
    deck = 92
    Draw.triangle(x, deck, x + 40, deck, x + 30, deck + 10, Color(120, 70, 40))
    Draw.rect(x + 6, deck - 8, 12, 10, Color(200, 60, 50))
    Draw.line(x + 28, deck, x + 28, deck - 32, 2, Color(60, 40, 30))
  end
end

Window.open("Harbour", 224, 144)
Window.background = Color(180, 210, 235)
spawn Sailing, Hull(12)
World.run
puts "closed after #{Time.tick} ticks"
