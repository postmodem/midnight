# A boat sails right across a harbour under the sun. Each tick prints
# where the boat is; the picture shows the sea, the sun and the boat.

component Boat
  x: Float
end

system sail
  each Boat do |boat|
    boat.x += 2
  end
end

system report
  each Boat do |boat|
    puts "tick #{Time.tick + 1}: boat at #{boat.x.to_i}"
  end
end

system paint
  # The sea: 224 wide and 48 high, around its middle at 112, 120.
  Draw.rect(112, 120, 224, 48, Color(30, 80, 160))
  Draw.circle(40, 30, 14, Color(255, 220, 90))
  each Boat do |boat|
    x = boat.x
    Draw.rect(x + 6, 84, 12, 10, Color(200, 60, 50))
    Draw.triangle(x, 92, x + 40, 92, x + 30, 102, Color(40, 70, 120))
    Draw.line(x + 28, 92, x + 28, 60, 2, Color(60, 40, 30))
  end
end

spawn Boat(12)
Window.background = Color(180, 210, 235)
Window.open("Harbour", 224, 144)
World.run
puts "closed after #{Time.tick} ticks"
