# The picture is drawn by a system that runs before `sail`, so the boat
# is drawn where it was before the tick's move.

component Boat
  x: Float
end

system paint
  Draw.rect(0, 96, 224, 48, Color(30, 80, 160))
  Draw.circle(40, 30, 14, Color(255, 220, 90))
  each Boat do |boat|
    x = boat.x
    Draw.triangle(x, 92, x + 40, 92, x + 30, 102, Color(120, 70, 40))
    Draw.rect(x + 6, 84, 12, 10, Color(200, 60, 50))
    Draw.line(x + 28, 92, x + 28, 60, 2, Color(60, 40, 30))
  end
end

system sail
  each Boat do |boat|
    boat.x += 2
  end
end

system report
  each Boat do |boat|
    puts "tick #{Time.tick + 1}: boat at #{boat.x.to_i}"
  end
end

spawn Boat(12)
Window.background = Color(180, 210, 235)
Window.open("Harbour", 224, 144)
World.run
puts "closed after #{Time.tick} ticks"
