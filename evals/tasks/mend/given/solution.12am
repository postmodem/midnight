# Counts the ballots of a vote for the village tree and prints the results.

BALLOTS = [
  "oak", "ash", "elm", "ash", "elm", "oak", "ash", "birch", "oak", "ash",
  "ash", "elm", "ash", "yew", "oak", "yew", "birch", "birch", "elm", "elm",
  "ash", "elm", "ash", "oak", "oak", "elm", "oak", "oak", "yew", "elm",
  "ash", "yew", "yew", "elm", "oak", "oak", "elm", "elm", "elm", "ash", "birch"
]

puts "ballots:"
BALLOTS.each_slice(6) do |row|
  puts row.join(" ")
end

counts = BALLOTS.tally
ranked = counts.sort_by { |name, votes| [-votes, name] }

puts "results:"
ranked.each do |name, votes|
  share = votes * 100.0 / BALLOTS.length
  puts format("%-6s %2d %5.1f%% %s", name, votes, share, "#" * votes)
end

puts "winner: #{ranked[0][0]}"
puts "margin: #{ranked[0][1] - ranked[1][1]}"
