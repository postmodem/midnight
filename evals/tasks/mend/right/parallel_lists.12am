# Counts the ballots of a vote for the village tree and prints the results.

BALLOTS = [
  "oak", "ash", "elm", "ash", "elm", "oak", "ash", "birch", "oak", "ash",
  "ash", "elm", "ash", "yew", "oak", "yew", "birch", "birch", "elm", "elm",
  "ash", "elm", "ash", "oak", "oak", "elm", "oak", "oak", "yew", "elm",
  "ash", "yew", "yew", "elm", "oak", "oak", "elm", "elm", "elm", "ash", "birch"
]
PER_ROW = 6

def tenths(n: Int) -> String
  "#{n / 10}.#{n % 10}"
end

puts "ballots:"
start = 0
while start < BALLOTS.length
  line = BALLOTS[start]
  k = start + 1
  while k < start + PER_ROW && k < BALLOTS.length
    line = line + " " + BALLOTS[k]
    k += 1
  end
  puts line
  start += PER_ROW
end

names = [""]
names.pop
votes = [0]
votes.pop
BALLOTS.each do |b|
  at = -1
  names.each_with_index do |n, i|
    at = i if n == b
  end
  if at < 0
    names.push(b)
    votes.push(1)
  else
    votes[at] += 1
  end
end

puts "results:"
first_votes = -1
second_votes = -1
winner = ""
until names.empty?
  best = 0
  1.upto(names.length - 1) do |i|
    if votes[i] > votes[best] || (votes[i] == votes[best] && names[i] < names[best])
      best = i
    end
  end
  name = names.delete_at(best)
  v = votes.delete_at(best)
  if first_votes < 0
    first_votes = v
    winner = name
  elsif second_votes < 0
    second_votes = v
  end
  share = tenths((v * 2000 / BALLOTS.length + 1) / 2)
  print name.ljust(6), " ", v.to_s.rjust(2), " ", share.rjust(5), "% "
  puts "#" * v
end

puts "winner: " + winner
puts "margin: " + (first_votes - second_votes).to_s
