# Counts the ballots of a vote for the village tree and prints the results.

BALLOTS = [
  "oak", "ash", "elm", "ash", "elm", "oak", "ash", "birch", "oak", "ash",
  "ash", "elm", "ash", "yew", "oak", "yew", "birch", "birch", "elm", "elm",
  "ash", "elm", "ash", "oak", "oak", "elm", "oak", "oak", "yew", "elm",
  "ash", "yew", "yew", "elm", "oak", "oak", "elm", "elm", "elm", "ash", "birch"
]

struct Tally
  name: String
  votes: Int
end

# Whether a ranks above b: more votes, or as many and a name that comes
# first in alphabetical order.
def above?(a: Tally, b: Tally) -> Bool
  a.votes > b.votes || (a.votes == b.votes && a.name < b.name)
end

puts "ballots:"
row = ""
BALLOTS.each_with_index do |name, i|
  row += " " unless row.empty?
  row += name
  if (i + 1) % 6 == 0
    puts row
    row = ""
  end
end

counts: [Tally] = []
BALLOTS.each do |name|
  found = false
  counts.length.times do |i|
    if counts[i].name == name
      counts[i].votes += 1
      found = true
    end
  end
  counts.push(Tally(name, 1)) unless found
end

ranked = counts
ranked.length.times do |i|
  j = i
  while j > 0 && above?(ranked[j], ranked[j - 1])
    t = ranked[j]
    ranked[j] = ranked[j - 1]
    ranked[j - 1] = t
    j -= 1
  end
end

puts "results:"
ranked.each do |t|
  share = t.votes * 100.0 / BALLOTS.length
  puts t.name.ljust(6) + " " + t.votes.to_s.rjust(2) + " " + share.round(1).to_s.rjust(5) + "% " + "#" * t.votes
end

puts "winner: #{ranked[0].name}"
puts "margin: #{ranked[0].votes - ranked[1].votes}"
