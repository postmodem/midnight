# Two ferries carry passengers from a dock. Passengers who wait too long
# give up and leave.

struct Arrival
  tick: Int
  num: Int
  patience: Int
end

component Passenger
  num: Int
  patience: Int
end

component Aboard
  ferry: Int
end

component Ferry
  num: Int
  seats: Int
  took: Int = 0
end

resource Dock
  left: Int = 0
end

FERRIES = 2
TICKS = 8

ARRIVALS = [
  Arrival(1, 6, 3), Arrival(1, 2, 2), Arrival(1, 9, 4), Arrival(1, 4, 1),
  Arrival(1, 1, 5), Arrival(1, 7, 2), Arrival(1, 3, 3), Arrival(1, 8, 2),
  Arrival(1, 5, 4),
  Arrival(2, 11, 2), Arrival(2, 10, 3),
  Arrival(3, 14, 3), Arrival(3, 12, 4), Arrival(3, 13, 1),
  Arrival(4, 16, 2), Arrival(4, 15, 1),
  Arrival(5, 17, 2),
  Arrival(6, 20, 3), Arrival(6, 18, 1), Arrival(6, 19, 2), Arrival(6, 22, 2),
  Arrival(6, 21, 1),
  Arrival(8, 23, 2)
]

def arrive(t: Int)
  Dock.left = 0
  ARRIVALS.each do |a|
    spawn Passenger(a.num, a.patience) if a.tick == t + 1
  end
end

# Each ferry in turn, ferry 1 first, fills its seats with the waiting
# passengers who have the lowest numbers.
def board
  1.upto(FERRIES) do |n|
    seats = 0
    each Ferry do |f|
      seats = f.seats if f.num == n
    end
    seats.times do
      first = Entity.none
      first_num = 0
      each Entity, Passenger, without: Aboard do |e, p|
        if first_num == 0 || p.num < first_num
          first = e
          first_num = p.num
        end
      end
      first.add(Aboard(n)) if first.alive?
    end
  end
end

def sail
  each Ferry do |f|
    f.took = 0
  end
  each Entity, Aboard do |e, a|
    each Ferry do |f|
      f.took += 1 if f.num == a.ferry
    end
    e.despawn
  end
end

def wait
  each Passenger, without: Aboard do |p|
    p.patience -= 1
  end
  each Entity, Passenger do |e, p|
    if p.patience == 0
      e.despawn
      Dock.left += 1
    end
  end
end

def report(t: Int)
  line = "tick #{t + 1}:"
  1.upto(FERRIES) do |n|
    each Ferry do |f|
      line += " ferry #{n} took #{f.took}," if f.num == n
    end
  end
  line += " #{Dock.left} left, waiting:"
  highest = 0
  each Passenger do |p|
    highest = max(highest, p.num)
  end
  first = true
  1.upto(highest) do |n|
    each Passenger do |p|
      if p.num == n
        line += first ? " #{n}" : ", #{n}"
        first = false
      end
    end
  end
  line += " none" if first
  puts line
end

spawn Ferry(num: 2, seats: 2)
spawn Ferry(num: 1, seats: 1)

TICKS.times do |t|
  arrive(t)
  board
  sail
  wait
  report(t)
end
