SIZE = 7

resource Pile
  grid: [[Int]] = []
  topples: Int = 0
  lost: Int = 0
end

def add_grain(r: Int, c: Int)
  if r < 0 || r >= SIZE || c < 0 || c >= SIZE
    Pile.lost += 1
  else
    Pile.grid[r][c] += 1
  end
end

def settle
  unstable = true
  while unstable
    unstable = false
    SIZE.times do |r|
      SIZE.times do |c|
        next if Pile.grid[r][c] < 4
        unstable = true
        k = Pile.grid[r][c] / 4
        Pile.grid[r][c] -= 4 * k
        Pile.topples += 1
        k.times do
          add_grain(r - 1, c)
          add_grain(r + 1, c)
          add_grain(r, c - 1)
          add_grain(r, c + 1)
        end
      end
    end
  end
end

def row_text(row: [Int]) -> String
  line = ""
  row.each_with_index do |h, i|
    line += " " if i > 0
    line += h.to_s
  end
  line
end

Pile.grid = [[0] * SIZE] * SIZE
Pile.grid[5][1] = 30
1.upto(80) do |n|
  if n <= 50
    add_grain(3, 3)
  else
    add_grain(1, 4)
  end
  settle
  puts "after #{n} grains: #{Pile.topples} topples, #{Pile.lost} lost" if n % 10 == 0
end
Pile.grid.each do |row|
  puts row_text(row)
end
