N = 7

# One list of 49 cells, row after row, and a stack of cells to look at.
cells = [0] * (N * N)
cells[5 * N + 1] = 30
topples = 0
lost = 0
80.times do |k|
  cells[k < 50 ? 3 * N + 3 : 1 * N + 4] += 1
  stack = [k < 50 ? 3 * N + 3 : 1 * N + 4]
  until stack.empty?
    i = stack.pop
    while cells[i] >= 4
      cells[i] -= 4
      topples += 1
      row = i / N
      col = i % N
      [[row - 1, col], [row + 1, col], [row, col - 1], [row, col + 1]].each do |rc|
        if rc[0] < 0 || rc[0] >= N || rc[1] < 0 || rc[1] >= N
          lost += 1
        else
          j = rc[0] * N + rc[1]
          cells[j] += 1
          stack.push(j) if cells[j] == 4
        end
      end
    end
  end
  print "after ", k + 1, " grains: ", topples, " topples, ", lost, " lost\n" if (k + 1) % 10 == 0
end
r = 0
while r < N
  text = cells[r * N].to_s
  1.upto(N - 1) do |col|
    text = text + " " + cells[r * N + col].to_s
  end
  puts text
  r += 1
end
