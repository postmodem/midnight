N = 7
cells = [0] * (N * N)
cells[5 * N + 1] = 30
stack = [5 * N + 1]
topples = 0
lost = 0
80.times do |k|
  at = k < 50 ? 3 * N + 3 : 1 * N + 4
  cells[at] += 1
  stack.push(at)
  until stack.empty?
    i = stack.pop
    while cells[i] >= 4
      cells[i] -= 4
      topples += 1
      row = i / N
      col = i % N
      [[row - 1, col], [row + 1, col], [row, col - 1], [row, col + 1]].each do |rc|
        if rc[0] < 0 || rc[0] >= N || rc[1] < 0 || rc[1] >= N
          lost += 1
        else
          j = rc[0] * N + rc[1]
          cells[j] += 1
          stack.push(j) if cells[j] == 4
        end
      end
    end
  end
  puts "after #{k + 1} grains: #{topples} topples, #{lost} lost" if (k + 1) % 10 == 0
end
cells.each_slice(N) do |row|
  text = ""
  row.each_with_index do |h, i|
    text += i == 0 ? "#{h}" : " #{h}"
  end
  puts text
end
