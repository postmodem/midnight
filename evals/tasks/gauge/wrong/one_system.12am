# One system changes the level, prints and draws: the right output and
# picture, but no `adjust` and no `report`.

resource Gauge
  level: Int = 5
end

system update
  Gauge.level += 1 if Keyboard.pressed?(Key::ArrowUp)
  Gauge.level -= 1 if Keyboard.pressed?(Key::ArrowDown)
  Gauge.level = Gauge.level.clamp(0, 12)
  marked = Keyboard.down?(Key::Space)
  level = Gauge.level
  puts "tick #{Time.tick + 1}: level #{level}, marker #{marked ? "shown" : "hidden"}"
  color = level >= 9 ? Color(230, 70, 50) : Color(60, 200, 90)
  Draw.rect(20, 52, 148, 14, Color(70, 70, 80))
  Draw.rect(22, 54, 12 * level, 10, color) if level > 0
  Draw.line(130, 46, 130, 72, 2, Color(255, 255, 255, 96))
  Draw.circle(184, 59, 7, level > 0 ? color : Color(90, 90, 90))
  if marked
    tip = 22 + 12 * level
    Draw.triangle(tip, 49, tip - 5, 40, tip + 5, 40, Color(250, 240, 120))
  end
end

Window.background = Color(30, 30, 34)
Window.open("Gauge", 200, 120)
World.run
puts "closed after #{Time.tick} ticks at level #{Gauge.level}"
