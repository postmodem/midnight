# The level lives in a component of one entity; presses are taken from
# the key events, once a tick however many came; two systems draw.

component Level
  value: Int
  marked: Bool
end

resource Pressed
  up: Bool = false
  down: Bool = false
end

system adjust
  Pressed.up = false
  Pressed.down = false
  on KeyPressed do |k|
    Pressed.up = true if k.key == Key::ArrowUp
    Pressed.down = true if k.key == Key::ArrowDown
  end
  each Level do |level|
    change = 0
    change += 1 if Pressed.up
    change -= 1 if Pressed.down
    level.value = (level.value + change).clamp(0, 12)
    level.marked = Keyboard.down?(Key::Space)
  end
end

system report
  each Level do |level|
    word = "hidden"
    word = "shown" if level.marked
    puts "tick #{Time.tick + 1}: level #{level.value}, marker #{word}"
  end
end

def bar_color(value: Int) -> Color
  return Color(90, 90, 90) if value == 0
  return Color(230, 70, 50) if value > 8
  Color(60, 200, 90)
end

system back
  each Level do |level|
    Draw.rect(20.0, 52.0, 148.0, 14.0, Color(70, 70, 80, 255))
    unless level.value == 0
      Draw.rect(22.0, 54.0, 12.0 * level.value, 10.0, bar_color(level.value))
    end
  end
end

system front
  each Level do |level|
    Draw.line(130, 46, 130, 72, 2, Color(255, 255, 255, 96))
    Draw.circle(184, 59, 7, bar_color(level.value))
    e = 22 + 12 * level.value
    Draw.triangle(e, 49, e - 5, 40, e + 5, 40, Color(250, 240, 120)) if level.marked
  end
end

spawn Level(5, false)
Window.background = Color(30, 30, 34)
Window.open("Gauge", 200, 120)
World.run
each Level do |level|
  puts "closed after #{Time.tick} ticks at level #{level.value}"
end
