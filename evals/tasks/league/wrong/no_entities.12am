# Prints the expected output with the three systems, but the teams are a
# list in a resource instead of entities, so no system has an `each`.
event Match
  home: String
  away: String
  home_goals: Int
  away_goals: Int
end

struct Row
  name: String
  points: Int
  diff: Int
end

resource League
  teams: [Row] = [Row("Bees", 0, 0), Row("Ants", 0, 0), Row("Cats", 0, 0), Row("Dogs", 0, 0), Row("Eels", 0, 0), Row("Fish", 0, 0)]
end

def above?(a: Row, b: Row) -> Bool
  return a.points > b.points if a.points != b.points
  return a.diff > b.diff if a.diff != b.diff
  a.name < b.name
end

system announce
  round = Time.tick + 1
  if round == 1
    emit Match("Bees", "Ants", 2, 1)
    emit Match("Cats", "Dogs", 0, 0)
    emit Match("Eels", "Fish", 1, 3)
  elsif round == 2
    emit Match("Bees", "Cats", 1, 3)
    emit Match("Ants", "Eels", 2, 2)
    emit Match("Dogs", "Fish", 1, 0)
  elsif round == 3
    emit Match("Bees", "Dogs", 0, 1)
    emit Match("Ants", "Fish", 1, 0)
    emit Match("Cats", "Eels", 2, 2)
  elsif round == 4
    emit Match("Bees", "Eels", 1, 1)
    emit Match("Ants", "Dogs", 0, 2)
    emit Match("Cats", "Fish", 1, 0)
  else
    emit Match("Bees", "Fish", 3, 0)
    emit Match("Ants", "Cats", 1, 1)
    emit Match("Dogs", "Eels", 0, 1)
  end
end

system score
  on Match do |m|
    League.teams.length.times do |i|
      name = League.teams[i].name
      if name == m.home || name == m.away
        mine = name == m.home ? m.home_goals : m.away_goals
        theirs = name == m.home ? m.away_goals : m.home_goals
        League.teams[i].diff += mine - theirs
        League.teams[i].points += 3 if mine > theirs
        League.teams[i].points += 1 if mine == theirs
      end
    end
  end
end

system table
  line = "round #{Time.tick + 1}:"
  first = true
  on Match do |m|
    line += first ? " " : ", "
    first = false
    line += "#{m.home} #{m.home_goals}-#{m.away_goals} #{m.away}"
  end
  puts line
  rows = League.teams
  i = 1
  while i < rows.length
    j = i
    while j > 0 && above?(rows[j], rows[j - 1])
      tmp = rows[j]
      rows[j] = rows[j - 1]
      rows[j - 1] = tmp
      j -= 1
    end
    i += 1
  end
  rows.each_with_index do |r, k|
    puts "#{k + 1}. #{r.name} #{r.points} #{r.diff}"
  end
end

5.times do
  World.tick
end
