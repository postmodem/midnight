tag Listed

component Team
  name: String
  points: Int = 0
  diff: Int = 0
end

event Match
  home: Entity
  away: Entity
  home_goals: Int
  away_goals: Int
end

resource Teams
  bees: Entity = Entity.none
  ants: Entity = Entity.none
  cats: Entity = Entity.none
  dogs: Entity = Entity.none
  eels: Entity = Entity.none
  fish: Entity = Entity.none
end

struct Row
  name: String
  points: Int
  diff: Int
end

def above?(a: Row, b: Row) -> Bool
  if a.points != b.points
    a.points > b.points
  elsif a.diff != b.diff
    a.diff > b.diff
  else
    a.name < b.name
  end
end

system announce
  round = Time.tick + 1
  if round == 1
    emit Match(Teams.bees, Teams.ants, 2, 1)
    emit Match(Teams.cats, Teams.dogs, 0, 0)
    emit Match(Teams.eels, Teams.fish, 1, 3)
  elsif round == 2
    emit Match(Teams.bees, Teams.cats, 1, 3)
    emit Match(Teams.ants, Teams.eels, 2, 2)
    emit Match(Teams.dogs, Teams.fish, 1, 0)
  elsif round == 3
    emit Match(Teams.bees, Teams.dogs, 0, 1)
    emit Match(Teams.ants, Teams.fish, 1, 0)
    emit Match(Teams.cats, Teams.eels, 2, 2)
  elsif round == 4
    emit Match(Teams.bees, Teams.eels, 1, 1)
    emit Match(Teams.ants, Teams.dogs, 0, 2)
    emit Match(Teams.cats, Teams.fish, 1, 0)
  else
    emit Match(Teams.bees, Teams.fish, 3, 0)
    emit Match(Teams.ants, Teams.cats, 1, 1)
    emit Match(Teams.dogs, Teams.eels, 0, 1)
  end
end

system score
  on Match do |m|
    m.home[Team].diff += m.home_goals - m.away_goals
    m.away[Team].diff += m.away_goals - m.home_goals
    if m.home_goals > m.away_goals
      m.home[Team].points += 3
    elsif m.home_goals < m.away_goals
      m.away[Team].points += 3
    else
      m.home[Team].points += 1
      m.away[Team].points += 1
    end
  end
end

system table
  line = "round #{Time.tick + 1}: "
  first = true
  on Match do |m|
    line += ", " unless first
    first = false
    line += "#{m.home[Team].name} #{m.home_goals}-#{m.away_goals} #{m.away[Team].name}"
  end
  puts line
  rows: [Row] = []
  each Team do |t|
    rows.push(Row(t.name, t.points, t.diff))
  end
  sorted: [Row] = []
  while rows.length > 0
    best = 0
    k = 1
    while k < rows.length
      best = k if above?(rows[k], rows[best])
      k += 1
    end
    sorted.push(rows[best])
    rows.delete_at(best)
  end
  sorted.each_with_index do |r, i|
    puts "#{i + 1}. #{r.name} #{r.points} #{r.diff}"
  end
end

Teams.fish = spawn Team("Fish"), Listed
Teams.eels = spawn Team("Eels")
Teams.dogs = spawn Team("Dogs"), Listed
Teams.cats = spawn Team("Cats")
Teams.bees = spawn Team("Bees"), Listed
Teams.ants = spawn Team("Ants")

5.times do
  World.tick
end
