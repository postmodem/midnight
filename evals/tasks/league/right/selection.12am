# Results in a constant list, teams in two components and a tag on half of
# them, spawned in reverse, a selection sort with `delete_at`.
struct Fixture
  round: Int
  home: String
  home_goals: Int
  away_goals: Int
  away: String
end

event Game
  home: String
  away: String
  home_goals: Int
  away_goals: Int
end

component Name
  text: String
end

component Standing
  points: Int
  scored: Int
  conceded: Int
end

tag Founder

FIXTURES = [
  Fixture(1, "Bees", 2, 1, "Ants"), Fixture(1, "Cats", 0, 0, "Dogs"),
  Fixture(1, "Eels", 1, 3, "Fish"), Fixture(2, "Bees", 1, 3, "Cats"),
  Fixture(2, "Ants", 2, 2, "Eels"), Fixture(2, "Dogs", 1, 0, "Fish"),
  Fixture(3, "Bees", 0, 1, "Dogs"), Fixture(3, "Ants", 1, 0, "Fish"),
  Fixture(3, "Cats", 2, 2, "Eels"), Fixture(4, "Bees", 1, 1, "Eels"),
  Fixture(4, "Ants", 0, 2, "Dogs"), Fixture(4, "Cats", 1, 0, "Fish"),
  Fixture(5, "Bees", 3, 0, "Fish"), Fixture(5, "Ants", 1, 1, "Cats"),
  Fixture(5, "Dogs", 0, 1, "Eels")
]

struct Line
  name: String
  points: Int
  diff: Int
end

def better?(a: Line, b: Line) -> Bool
  if a.points != b.points
    a.points > b.points
  elsif a.diff != b.diff
    a.diff > b.diff
  else
    a.name < b.name
  end
end

system announce
  FIXTURES.each do |f|
    emit Game(f.home, f.away, f.home_goals, f.away_goals) if f.round == Time.tick + 1
  end
end

system score
  on Game do |g|
    each Name, Standing do |n, s|
      next unless n.text == g.home || n.text == g.away
      scored = n.text == g.home ? g.home_goals : g.away_goals
      conceded = n.text == g.home ? g.away_goals : g.home_goals
      s.scored += scored
      s.conceded += conceded
      if scored > conceded
        s.points += 3
      elsif scored == conceded
        s.points += 1
      end
    end
  end
end

system table
  header = "round #{Time.tick + 1}:"
  first = true
  on Game do |g|
    header += first ? " " : ", "
    first = false
    header += g.home + " " + g.home_goals.to_s + "-" + g.away_goals.to_s + " " + g.away
  end
  puts header
  lines: [Line] = []
  each Name, Standing do |n, s|
    lines.push(Line(n.text, s.points, s.scored - s.conceded))
  end
  place = 1
  while !lines.empty?
    best = 0
    lines.each_with_index do |l, i|
      best = i if better?(l, lines[best])
    end
    l = lines.delete_at(best)
    puts "#{place}. #{l.name} #{l.points} #{l.diff}"
    place += 1
  end
end

spawn Name("Fish"), Standing(0, 0, 0)
spawn Name("Eels"), Standing(0, 0, 0)
spawn Name("Dogs"), Standing(0, 0, 0), Founder
spawn Name("Cats"), Standing(0, 0, 0)
spawn Name("Ants"), Standing(0, 0, 0), Founder
spawn Name("Bees"), Standing(0, 0, 0), Founder

5.times do
  World.tick
end
