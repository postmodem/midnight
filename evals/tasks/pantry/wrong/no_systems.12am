struct Item
  name: String
  kind: String
  stock: Int
  sold: Int = 0
end

struct Move
  day: Int
  name: String
  amount: Int
end

items = [
  Item("pears", "Fruit", 6), Item("milk", "Dairy", 5), Item("rice", "Grain", 9),
  Item("apples", "Fruit", 4), Item("oats", "Grain", 3), Item("butter", "Dairy", 4),
  Item("figs", "Fruit", 0), Item("flour", "Grain", 7), Item("cheese", "Dairy", 2)
]
deliveries = [
  Move(1, "figs", 3), Move(2, "oats", 5), Move(2, "cheese", 2), Move(3, "milk", 6),
  Move(3, "apples", 2), Move(3, "rice", 3), Move(4, "butter", 2), Move(4, "pears", 1)
]
orders = [
  Move(1, "rice", 4), Move(1, "milk", 2), Move(1, "cheese", 3), Move(1, "pears", 1), Move(1, "oats", 3),
  Move(2, "apples", 4), Move(2, "butter", 1), Move(2, "flour", 2), Move(2, "figs", 5), Move(2, "milk", 3),
  Move(2, "rice", 2), Move(2, "rice", 4),
  Move(3, "pears", 2), Move(3, "cheese", 4), Move(3, "milk", 6), Move(3, "apples", 3), Move(3, "butter", 3),
  Move(3, "oats", 1),
  Move(4, "flour", 5), Move(4, "figs", 1), Move(4, "rice", 3), Move(4, "oats", 4), Move(4, "cheese", 1),
  Move(4, "butter", 2)
]

1.upto(4) do |day|
  deliveries.each do |d|
    next unless d.day == day
    items.length.times do |i|
      items[i].stock += d.amount if items[i].name == d.name
    end
  end
  filled = 0
  refused = 0
  orders.each do |o|
    next unless o.day == day
    items.length.times do |i|
      next unless items[i].name == o.name
      if items[i].stock >= o.amount
        items[i].stock -= o.amount
        items[i].sold += o.amount
        filled += 1
      else
        refused += 1
      end
    end
  end
  puts "day #{day}: #{filled} filled, #{refused} refused"
  ["Grain", "Dairy", "Fruit"].each do |kind|
    left: [Item] = []
    sold = 0
    items.length.times do |i|
      if items[i].kind == kind
        left.push(items[i])
        sold += items[i].sold
        items[i].sold = 0
      end
    end
    text = "#{kind} (#{sold} sold): "
    first = true
    until left.empty?
      best = 0
      left.each_with_index do |it, i|
        b = left[best]
        best = i if it.stock > b.stock || (it.stock == b.stock && it.name < b.name)
      end
      text += first ? "" : ", "
      text += "#{left[best].name} #{left[best].stock}"
      first = false
      left.delete_at(best)
    end
    puts text
  end
end
