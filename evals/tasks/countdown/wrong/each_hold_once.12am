resource Launch
  count: Int = 20
  pressure: Int = 30
  hold: Int = 0
  stage: String = ""
  done: Bool = false
  aborts: Int = 0
  held_at_six: Bool = false
end

ABORT_ABOVE = 88

def rate(count: Int) -> Int
  if count >= 11
    2
  elsif count >= 4
    6
  elsif count >= 1
    8
  else
    0
  end
end

def stage_name(count: Int) -> String
  if count >= 11
    "fueling"
  elsif count >= 4
    "pressurizing"
  elsif count >= 1
    "ignition"
  else
    "liftoff"
  end
end

system step
  if Launch.hold > 0
    Launch.hold -= 1
    Launch.pressure -= 2
    Launch.stage = "hold"
  else
    Launch.count -= 1
    Launch.pressure += rate(Launch.count)
    Launch.stage = stage_name(Launch.count)
    Launch.hold = 3 if Launch.count == 15
    if Launch.count == 6 && !Launch.held_at_six
      Launch.hold = 2
      Launch.held_at_six = true
    end
  end
  if Launch.pressure > ABORT_ABOVE
    Launch.aborts += 1
    Launch.count = 10
    Launch.pressure = 40
    Launch.hold = 4
    Launch.stage = "abort"
  end
  Launch.done = Launch.count == 0 || Launch.aborts == 2
end

system report
  if Launch.aborts == 2
    puts "tick #{Time.tick + 1}: scrubbed"
    return
  end
  puts "tick #{Time.tick + 1}: T-#{Launch.count} #{Launch.stage}, pressure #{Launch.pressure}"
end

until Launch.done
  World.tick
end
