enum Stage
  Fueling
  Pressurizing
  Ignition
  Liftoff
end

component Rocket
  countdown: Int = 20
  pressure: Int = 30
  holding: Int = 0
  note: String = ""
  aborted: Int = 0
end

def stage_of(c: Int) -> Stage
  return Stage::Liftoff if c == 0
  return Stage::Ignition if c <= 3
  return Stage::Pressurizing if c <= 10
  Stage::Fueling
end

def change(s: Stage) -> Int
  case s
  when Stage::Fueling then 2
  when Stage::Pressurizing then 6
  when Stage::Ignition then 8
  when Stage::Liftoff then 0
  end
end

system countdown
  each Rocket do |r|
    if r.holding == 0
      r.countdown = r.countdown - 1
      s = stage_of(r.countdown)
      r.pressure = r.pressure + change(s)
      r.note = s.to_s.downcase
      case r.countdown
      when 15 then r.holding = 3
      when 6 then r.holding = 2
      end
    else
      r.holding = r.holding - 1
      r.pressure = r.pressure - 2
      r.note = "hold"
    end
  end
end

system abort
  each Rocket do |r|
    next unless r.pressure > 88
    r.aborted += 1
    r.note = "scrubbed"
    next if r.aborted == 2
    r.countdown = 10
    r.pressure = 40
    r.holding = 4
    r.note = "abort"
  end
end

system show
  each Rocket do |r|
    if r.note == "scrubbed"
      puts "tick #{Time.tick + 1}: scrubbed"
    else
      puts "tick #{Time.tick + 1}: T-#{r.countdown} #{r.note}, pressure #{r.pressure}"
    end
  end
end

rocket = spawn Rocket()
while rocket[Rocket].countdown > 0 && rocket[Rocket].note != "scrubbed"
  World.tick
end
