# SHAPES shapes of about 16 by 16 points, the four kinds in turn, drawn by
# a GPU system in a window of 1920 by 1080 at a scale of 1, for TICKS
# ticks with no pause between them. Prints the time per tick.
#
# bench/draws.sh runs it with SHAPES set to several numbers, shown in the
# compositor of the window tests and headless. A headless window makes no
# picture, so the difference of the two is what a frame of these shapes
# costs the device: the next frame waits for the one before.

SHAPES = 100_000
TICKS = 200

component Spot
  x: Float32
  y: Float32
  kind: Int32
end

gpu system show
  each Spot do |s|
    c = Color((s.kind * 60 + 40).clamp(0, 255), (200 - s.kind * 40).clamp(0, 255), 120)
    case s.kind
    when 0
      Draw.rect(s.x, s.y, 16, 16, c)
    when 1
      Draw.circle(s.x + 8, s.y + 8, 8, c)
    when 2
      Draw.line(s.x, s.y, s.x + 16, s.y + 16, 3, c)
    else
      Draw.triangle(s.x, s.y + 16, s.x + 8, s.y, s.x + 16, s.y + 16, c)
    end
  end
end

Time.dt = 0.0
Window.open("Draw frame", 1920, 1080)
SHAPES.times do |i|
  spawn Spot((i * 37) % 1904, (i * 101) % 1064, i % 4)
end

# The first ticks build the pipelines and send the spots.
10.times do
  World.tick
end

start = clock
TICKS.times do
  World.tick
end
seconds = clock - start

puts "shapes: #{SHAPES}"
puts "ms_per_tick: #{(seconds * 1000 / TICKS).round(3)}"
