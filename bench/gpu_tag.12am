# One GPU block moves a million entities; after every tick, top-level code
# adds a tag to one of them, which moves its row to another table that the
# block also runs over. Prints the time per tick.
TICKS = 300
ENTITIES = 1_000_000

component Position
  x: Float32
  y: Float32
end

component Velocity
  dx: Float32
  dy: Float32
end

tag Marked

gpu system move
  each Position, Velocity do |pos, vel|
    pos.x += vel.dx * Time.dt
    pos.y += vel.dy * Time.dt
  end
end

chosen: [Entity] = []
ENTITIES.times do |i|
  e = spawn Position(i % 1000, i / 1000), Velocity((i % 7 - 3) * 0.5, (i % 5 - 2) * 0.25)
  chosen.push(e) if i % 3000 == 7
end

Time.dt = 1.0 / 64
World.tick

start = clock
TICKS.times do |i|
  World.tick
  chosen[i].add(Marked)
end
seconds = clock - start
puts "ms_per_tick: #{(seconds * 1000 / TICKS).round(4)}"
puts "marked: #{World.count(Position, with: Marked)}"
